+/* -------------------------------------------------------------------------
+ * Marcador C (bancada 02, opcional): inverte o nivel a cada volta do laco do
+ * logic_engine que termina por timeout do k_poll (a mesma condicao que
+ * hub_metrics_loop_tick() conta). O intervalo entre bordas consecutivas e o
+ * periodo do laco. Inverter, e nao pulsar, para que a borda sobreviva a uma
+ * amostragem lenta do analisador.
+ *
+ * So existe com o alias la-marker-c, que vem de um overlay de bancada
+ * (plano_ieee/patches/marcador_c.overlay). Sem ele, nao gera codigo.
+ * ------------------------------------------------------------------------- */
+#if DT_NODE_EXISTS(DT_ALIAS(la_marker_c))
+
+static inline void argus_marker_c_toggle(void)
+{
+    static const struct gpio_dt_spec c = GPIO_DT_SPEC_GET(DT_ALIAS(la_marker_c), gpios);
+    static bool pronto;
+
+    if(!pronto)
+    {
+        if(!device_is_ready(c.port))
+            return;
+        gpio_pin_configure_dt(&c, GPIO_OUTPUT_INACTIVE);
+        pronto = true;
+    }
+    gpio_pin_toggle_dt(&c);
+}
+
+#else
+
+static inline void argus_marker_c_toggle(void) {}
+
+#endif
+
 #endif /* MARKERS_H */
